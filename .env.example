# Optional realtime input transcription language.
# Defaults to "en". Set to a backend-supported code such as "zh" for Chinese.
# REALTIME_TRANSCRIPTION_LANGUAGE="en"

# Hugging Face connection mode: "deployed" or "local".
# Deployed mode uses the built-in Hugging Face server.
# Defaults to "deployed" when unset.
# HF_REALTIME_CONNECTION_MODE="deployed"

# Direct Hugging Face realtime endpoint for local/LAN backends.
# Accepts either the base URL (`ws://127.0.0.1:8765/v1`) or the full realtime URL
# (`ws://127.0.0.1:8765/v1/realtime`). Used when HF_REALTIME_CONNECTION_MODE=local.
# HF_REALTIME_WS_URL="ws://127.0.0.1:8765/v1/realtime"

# Hugging Face token for accessing datasets/models
HF_TOKEN=

# Optional built-in profile selector. Use a folder name from profiles/.
# If unset, the app uses the default profile unless startup settings were saved from the UI.
# REACHY_MINI_CUSTOM_PROFILE=mars_rover

# Optional external profile/tool directories
# REACHY_MINI_EXTERNAL_PROFILES_DIRECTORY=external_content/external_profiles
# REACHY_MINI_EXTERNAL_TOOLS_DIRECTORY=external_content/external_tools

# Optional: discover and auto-load all tools found in REACHY_MINI_EXTERNAL_TOOLS_DIRECTORY,
# even if they are not enabled by the selected profile or its Tool access override.
# This is convenient for downloaded tools used with built-in/default profiles.
# AUTOLOAD_EXTERNAL_TOOLS=1

# Minutes of inactivity before Reachy goes to sleep and the app stops. Default 1440 (one day), 0 disables.
# REACHY_MINI_APP_TIMEOUT_MINUTES=1440

# ---- Droid companion (active when the "droid" profile is selected) ----
# Minutes without anyone talking (and nobody in view) before the droid goes dormant. 0 disables.
# DROID_DORMANT_AFTER_MINUTES=20
# Register this app as the robot's startup app so the droid starts on every power-on. Default on.
# DROID_AUTOSTART=1
# Small idle behaviours (beeps, glances, occasional remarks) while nobody is talking. Default on.
# DROID_IDLE_LIFE=1
# Phone notifications through ntfy: install the ntfy app and subscribe to a long, private topic name.
# DROID_NTFY_TOPIC=
# DROID_NTFY_SERVER=https://ntfy.sh
# Hugging Face model used to summarise sessions and write the diary (uses HF_TOKEN).
# DROID_SUMMARY_MODEL=Qwen/Qwen2.5-7B-Instruct
# Droid voice filter on the speaker output (band-pass, light ring modulation, metallic resonance). Default on.
# DROID_VOICE_FX=1

# Self-development. A fine-grained GitHub token with only "Issues: read and write" on your fork:
# the droid files upgrade requests as issues and never pushes code.
# DROID_GITHUB_REPO=owner/reachy_mini_conversation_app
# DROID_GITHUB_TOKEN=
# The Hugging Face Space that mirrors your fork's main branch (see .github/workflows/droid-sync-space.yml).
# While dormant between 02:00 and 06:00 the droid installs newer revisions, with automatic rollback. Default on.
# DROID_UPDATE_SPACE=owner/k3-droid
# DROID_AUTO_UPDATE=1

# Smart home through Home Assistant (lights, switches, fans, scenes, scripts, media players; never locks).
# DROID_HOME_ASSISTANT_URL=http://homeassistant.local:8123
# DROID_HOME_ASSISTANT_TOKEN=
